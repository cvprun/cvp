{
  "permissions": {
    "allow": [
      "Bash(./ci.sh test)",
      "Bash(./black.sh)",
      "Bash(./black.sh --fix)",
      "Bash(./isort.sh)",
      "Bash(./isort.sh --fix)",
      "Bash(./flake8.sh)",
      "Bash(./mypy.sh)",
      "Bash(./pytest.sh)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
    ],
    "ask": [
      "Bash(./python:*)",
      "Bash(./run:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code CVP' 'Awaiting your input'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Write|Edit)",
        "hooks": [
          {
            "type": "command",
            "command": "./black.sh --fix",
            "statusMessage": "Formatting code..."
          },
          {
            "type": "command",
            "command": "./isort.sh --fix",
            "statusMessage": "Import sorting and fixing code..."
          }
        ]
      }
    ]
  }
}